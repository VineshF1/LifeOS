# Copy to backend/.env and fill in. NEVER commit the real file.
# Use Neon's pooled endpoint (-pooler, port 6543) in production.
DATABASE_URL=postgresql://user:pass@localhost:5432/lifeos
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
NVIDIA_API_KEY=

# Billing: leave ALL four empty for demo mode, or set ALL four for live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

UPLOAD_DIR=/app/uploads
FRONTEND_URL=http://localhost:3000
