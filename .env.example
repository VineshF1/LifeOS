# Prova — root .env (for docker-compose)
# Copy to .env and fill. Never commit the real .env.
# Compose reads this file at the repo root.

# Database — Neon pooled endpoint in prod (:6543, -pooler), local Postgres in dev
DATABASE_URL=postgresql://user:password@localhost:5432/prova

# Auth
JWT_SECRET=change-me-in-production

# NVIDIA NIM — chat + embeddings
NVIDIA_API_KEY=nvapi-...

# Redis — compose overrides to redis://redis:6379/0, local dev uses localhost
REDIS_URL=redis://localhost:6379/0

# Billing — leave ALL empty for demo mode, or set ALL for live Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# legacy key some compose files reference (keep empty or same as SECRET)
RAZORPAY_SECRET=

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Storage
UPLOAD_DIR=/app/uploads
